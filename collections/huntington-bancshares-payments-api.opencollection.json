        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate a payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.huntington.com/v1/payments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a payment transaction from a treasury account."
        }
      ]
    }
  ],
  "bundled": true
}