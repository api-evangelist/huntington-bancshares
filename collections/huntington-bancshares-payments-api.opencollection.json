{
  "opencollection": "1.0.0",
  "info": {
    "name": "Huntington Bank Treasury Management Accounts Payments API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.huntington.com/oauth/token",
